;; -*- lexical-binding: t -*-

(require 'canvas)

(defconst canvas-light-theme-palette
  '((foreground . black)
    (background . white)
    (inline-code . cyan)

    (white . "#ffffff")
    (white-bright . "#e7e7e7")
    (red . "#721045")
    (red-bright . "#8f1313")
    (green . "#006800")
    (yellow . "#6f5500")
    (yellow-bright . "#f3d000")
    (blue . "#0031a9")
    (blue-bright . "#354fcf")
    (magenta . "#8f0075")
    (magenta-bright . "#531ab6")
    (cyan . "#005e8b")
    (cyan-bright . "#c0deff")
    (black . "#000000")
    (black-bright . "#595959")

    (mode-line-active-bg . "#c8c8c8")
    (mode-line-active-border . "#5a5a5a")
    (mode-line-inactive-bg . "#e6e6e6")
    (mode-line-inactive-fg . "#585858")
    (mode-line-inactive-border . "#a3a3a3")
    (mode-line-hover-bg . "#b2e4dc")
    (mode-line-info . "#002580")
    (completion-bg . cyan-bright)
    (code-bg . "#f3f3f3")
    (completion-match . blue)
    (completion-discriminator . magenta)
    (keyword . magenta-bright)
    (type . cyan)
    (constant . blue-bright)
    (variable . black)
    (string . blue-bright)
    (number . blue-bright)
    (function . red)
    (operator . black)
    (builtin . magenta)
    (comment . black-bright)
    (doc . black-bright)
    (region . white-bright)
    (search-current . yellow-bright)
    (search-alternative . region)
    (prompt . cyan)
    (paren-match . completion-bg)
    (directory . blue)
    (heading . black)
    (diff-added-bg . "#c1f2d1")
    (diff-removed-bg . "#ffd8d5")
    (diff-added-refine-bg . "#aee5be")
    (diff-removed-refine-bg . "#f3b5af")
    (diff-added-fg . green)
    (diff-removed-fg . red-bright))
  "Colors for the `canvas-light' theme.")

(deftheme canvas-light
  "")

(canvas-apply 'canvas-light canvas-light-theme-palette)

(provide-theme 'canvas-light)
