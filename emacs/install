#!/usr/bin/env bash

# install - build Emacs from a release tarball and install it to
#           ~/.local/opt.
#
# usage: emacs/install

set -euo pipefail

EMACS_VERSION="31.1"

DIRECTORY="$(dirname "$(realpath "$0")")"
SOURCE="$HOME/.local/src/emacs-$EMACS_VERSION"
PREFIX="$HOME/.local/opt/emacs-$EMACS_VERSION"

sudo apt install -y $(xargs <"$DIRECTORY/packages")

mkdir -p "$HOME/.local/src" "$HOME/.local/bin" "$HOME/.local/share/applications"

curl -fsSL -o "$SOURCE.tar.xz" "https://ftpmirror.gnu.org/emacs/emacs-$EMACS_VERSION.tar.xz"
curl -fsSL -o "$SOURCE.tar.xz.sig" "https://ftpmirror.gnu.org/emacs/emacs-$EMACS_VERSION.tar.xz.sig"
# The keyring comes from GNU's own server rather than the mirror, so that a
# compromised mirror cannot replace both the tarball and the key.
curl -fsSL -o "$HOME/.local/src/gnu-keyring.gpg" https://ftp.gnu.org/gnu/gnu-keyring.gpg
gpgv --keyring "$HOME/.local/src/gnu-keyring.gpg" "$SOURCE.tar.xz.sig" "$SOURCE.tar.xz"

rm -rf "$SOURCE" "$PREFIX"
tar -xJf "$SOURCE.tar.xz" -C "$HOME/.local/src"
cd "$SOURCE"

./configure \
	--prefix="$PREFIX" \
	--with-pgtk \
	--with-native-compilation \
	--with-tree-sitter \
	--with-modules \
	--without-sound \
	--without-libsystemd \
	CFLAGS="-O2 -march=native"
make -j"$(nproc)"
make install

ln -sfn "$PREFIX" "$HOME/.local/opt/emacs"
ln -sf "$HOME/.local/opt/emacs/bin/emacs" "$HOME/.local/bin/emacs"
ln -sf "$HOME/.local/opt/emacs/share/applications/emacs.desktop" "$HOME/.local/share/applications/emacs.desktop"
