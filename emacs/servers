#!/usr/bin/env bash

# servers - install the language servers Emacs uses with npm, uv, and Cargo.
#
# usage: emacs/servers

set -euo pipefail

SVELTE_LANGUAGE_SERVER_VERSION="0.18"
TYPESCRIPT_VERSION="7.0"
TYPESCRIPT_LANGUAGE_SERVER_VERSION="6.0"
YAML_LANGUAGE_SERVER_VERSION="1.24"
RASSUMFRASSUM_VERSION="0.3"
TINYMIST_VERSION="0.15.10"

npm install -g \
	"svelte-language-server@~$SVELTE_LANGUAGE_SERVER_VERSION" \
	"typescript@~$TYPESCRIPT_VERSION" \
	"typescript-language-server@~$TYPESCRIPT_LANGUAGE_SERVER_VERSION" \
	"yaml-language-server@~$YAML_LANGUAGE_SERVER_VERSION"
uv tool install --upgrade "rassumfrassum==$RASSUMFRASSUM_VERSION.*"
# tinymist-cli is not published on crates.io, so it installs from a release tag.
cargo install --locked --git https://github.com/Myriad-Dreamin/tinymist --tag "v$TINYMIST_VERSION" tinymist-cli
