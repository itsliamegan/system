#!/usr/bin/env bash

# configure - link the instructions and conventions shared by every agent.
#
# usage: agents/configure

set -euo pipefail

DIRECTORY="$(dirname "$(realpath "$0")")"

mkdir -p "$XDG_CONFIG_HOME/agents"
ln -sf "$DIRECTORY/AGENTS.md" "$XDG_CONFIG_HOME/agents/AGENTS.md"
ln -sfn "$DIRECTORY/conventions" "$XDG_CONFIG_HOME/agents/conventions"
