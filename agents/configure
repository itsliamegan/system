#!/usr/bin/env bash

# configure - link the instructions, conventions, and skills shared by every
#             agent.
#
# usage: agents/configure

set -euo pipefail

DIRECTORY="$(dirname "$(realpath "$0")")"

mkdir -p "$HOME/.agents"
ln -sf "$DIRECTORY/AGENTS.md" "$HOME/.agents/AGENTS.md"
ln -sfn "$DIRECTORY/conventions" "$HOME/.agents/conventions"
ln -sfn "$DIRECTORY/skills" "$HOME/.agents/skills"
