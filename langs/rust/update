#!/usr/bin/env bash

# update - update the Rust pin in the install script to the newest stable
#          release.
#
# usage: langs/rust/update

set -euo pipefail

cd "$(dirname "$(realpath "$0")")"

version="$(curl -fsSL https://static.rust-lang.org/dist/channel-rust-stable.toml \
	| sed -n '/^\[pkg\.rust\]$/{n;s/^version = "\([^ ]*\) .*/\1/p}' \
	| cut -d. -f1-2)"
if [[ ! "$version" =~ ^[0-9.]+$ ]]; then
	echo "update: no release found for rust" >&2
	exit 1
fi

sed -i "s/^RUST_VERSION=\".*\"\$/RUST_VERSION=\"$version\"/" install
