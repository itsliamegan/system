#!/usr/bin/env bash

# install - install rustup and the Rust toolchain.
#
# usage: langs/rust/install

set -euo pipefail

RUST_VERSION="1.99" # rust

# The installer otherwise appends to the shell profile, which is a link into
# this repository.
curl -fsSL https://sh.rustup.rs | sh -s -- -y --no-modify-path --profile minimal --default-toolchain none
rustup toolchain install "$RUST_VERSION" --profile minimal --component rust-analyzer,rustfmt,clippy
rustup default "$RUST_VERSION"
