#!/usr/bin/env bash

# install - install a Node release to ~/.local/opt.
#
# usage: langs/node/install

set -euo pipefail

NODE_VERSION="26.12.0"

RELEASE="node-v$NODE_VERSION-linux-x64"
TARBALL="$HOME/.local/src/$RELEASE.tar.xz"
PREFIX="$HOME/.local/opt/node-$NODE_VERSION"

mkdir -p "$HOME/.local/src" "$HOME/.local/bin"

curl -fsSL -o "$TARBALL" "https://nodejs.org/dist/v$NODE_VERSION/$RELEASE.tar.xz"
curl -fsSL -o "$HOME/.local/src/$RELEASE.SHASUMS256.txt" "https://nodejs.org/dist/v$NODE_VERSION/SHASUMS256.txt"
# SHASUMS256.txt names the tarball without a directory.
cd "$HOME/.local/src"
grep " $RELEASE.tar.xz\$" "$RELEASE.SHASUMS256.txt" | sha256sum -c -

rm -rf "$PREFIX"
mkdir -p "$PREFIX"
tar -xJf "$TARBALL" -C "$PREFIX" --strip-components=1

ln -sfn "$PREFIX" "$HOME/.local/opt/node"
for command in "$HOME"/.local/opt/node/bin/*; do
	ln -sf "$command" "$HOME/.local/bin/$(basename "$command")"
done
