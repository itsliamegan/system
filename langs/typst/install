#!/usr/bin/env bash

# install - install the Tinymist language server for Typst with Cargo.
#
# usage: langs/typst/install

set -euo pipefail

REVISION="5e62f1a9205b4c08a3892ecc89844cbadf8ae1bf"

export CARGO_HOME="${CARGO_HOME:-$HOME/.local/share/cargo}"
export RUSTUP_HOME="${RUSTUP_HOME:-$HOME/.local/share/rustup}"

"$CARGO_HOME/bin/cargo" install --locked --git https://github.com/Myriad-Dreamin/tinymist --rev "$REVISION" tinymist-cli
