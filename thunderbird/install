#!/usr/bin/env bash

# install - install Thunderbird's monthly release from Mozilla's apt repository.
#
# usage: thunderbird/install

set -euo pipefail

DIRECTORY="$(dirname "$(realpath "$0")")"

sudo install -d -m 0755 /etc/apt/keyrings
sudo curl -fsSL -o /etc/apt/keyrings/mozilla.asc https://packages.mozilla.org/apt/repo-signing-key.gpg
sudo install -m 0644 "$DIRECTORY/thunderbird.sources" /etc/apt/sources.list.d/thunderbird.sources

# Debian ships Thunderbird's extended support release under the same name.
sudo install -m 0644 "$DIRECTORY/thunderbird.pref" /etc/apt/preferences.d/thunderbird.pref

sudo apt update
sudo apt install -y thunderbird
