#!/usr/bin/env bash

# install - install Thunderbird's monthly release from Mozilla's apt repository.
#
# usage: thunderbird/install

set -euo pipefail

sudo install -d -m 0755 /etc/apt/keyrings
sudo curl -fsSL https://packages.mozilla.org/apt/repo-signing-key.gpg -o /etc/apt/keyrings/mozilla.asc
sudo install -m 0644 "$(dirname "$0")/thunderbird.sources" /etc/apt/sources.list.d/thunderbird.sources

# Debian ships Thunderbird's extended support release under the same name.
sudo install -m 0644 "$(dirname "$0")/thunderbird.pref" /etc/apt/preferences.d/thunderbird.pref

sudo apt update
sudo apt install -y thunderbird
