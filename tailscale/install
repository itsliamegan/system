#!/usr/bin/env bash

# install - install Tailscale from Tailscale's apt repository.
#
# usage: tailscale/install

set -euo pipefail

DIRECTORY="$(dirname "$(realpath "$0")")"
KEYRING="/usr/share/keyrings/tailscale-archive-keyring.gpg"

# The tailscale-archive-keyring package owns the key once it is installed and
# replaces it when Tailscale rotates keys, so only a new system downloads it.
if [ ! -e "$KEYRING" ]; then
	sudo curl -fsSL -o "$KEYRING" https://pkgs.tailscale.com/stable/debian/sid.noarmor.gpg
fi
sudo install -m 0644 "$DIRECTORY/tailscale.sources" /etc/apt/sources.list.d/tailscale.sources

sudo apt update
sudo apt install -y tailscale tailscale-archive-keyring
