#!/usr/bin/env bash

# install - install Git, and the GitHub CLI from GitHub's apt repository.
#
# usage: git/install

set -euo pipefail

DIRECTORY="$(dirname "$(realpath "$0")")"

sudo install -d -m 0755 /etc/apt/keyrings
sudo curl -fsSL -o /etc/apt/keyrings/github-cli.gpg https://cli.github.com/packages/githubcli-archive-keyring.gpg
sudo install -m 0644 "$DIRECTORY/github-cli.sources" /etc/apt/sources.list.d/github-cli.sources

sudo apt update
sudo apt install -y git gh
