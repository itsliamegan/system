#!/usr/bin/env bash

# install - install the GitHub CLI from GitHub's apt repository.
#
# usage: git/install

set -euo pipefail

sudo install -d -m 0755 /etc/apt/keyrings
sudo curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli-archive-keyring.gpg
sudo install -m 0644 "$(dirname "$0")/github-cli.sources" /etc/apt/sources.list.d/github-cli.sources

sudo apt update
sudo apt install -y gh
