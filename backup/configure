#!/usr/bin/env bash

# configure - link the backup services and timers into the systemd user
#             directory, link the data set files beside the secrets, and
#             enable the timers.
#
# usage: backup/configure
#
# Each data set is backed up by its own instance of the backup services, named
# for the data set's restic tag, such as backup-local@archive.service. The
# instance reads <tag>.env, which sets BACKUP_PATH, the directory to back up
# relative to the home directory, and KEEP, the forget policy. Each instance has
# its own timer file, so each data set has its own schedule.
#
# The services read secrets that stay out of this repository:
#
#   ~/.config/backup/password     the restic password, shared by both
#                                 repositories
#   ~/.config/backup/offsite.env  the B2 repository and its application key:
#                                 RESTIC_REPOSITORY=s3:https://s3.<region>.backblazeb2.com/<bucket>
#                                 AWS_ACCESS_KEY_ID=<key ID>
#                                 AWS_SECRET_ACCESS_KEY=<application key>
#
# A new disk or bucket needs its repository created by hand with `restic init`.
# Check that the disk is mounted first.

set -euo pipefail

DIRECTORY="$(dirname "$(realpath "$0")")"
CONFIG="$XDG_CONFIG_HOME/backup"
UNITS="$XDG_CONFIG_HOME/systemd/user"

mkdir -p "$CONFIG"
# The directory holds the secrets, so only you can read it.
chmod 700 "$CONFIG"
ln -sf "$DIRECTORY/documents.env" "$CONFIG/documents.env"
ln -sf "$DIRECTORY/archive.env" "$CONFIG/archive.env"
ln -sf "$DIRECTORY/photos.env" "$CONFIG/photos.env"

mkdir -p "$UNITS"
ln -sf "$DIRECTORY/backup-failed@.service" "$UNITS/backup-failed@.service"
ln -sf "$DIRECTORY/backup-local@.service" "$UNITS/backup-local@.service"
ln -sf "$DIRECTORY/backup-local@documents.timer" "$UNITS/backup-local@documents.timer"
ln -sf "$DIRECTORY/backup-local@archive.timer" "$UNITS/backup-local@archive.timer"
ln -sf "$DIRECTORY/backup-local@photos.timer" "$UNITS/backup-local@photos.timer"
ln -sf "$DIRECTORY/backup-local-check.service" "$UNITS/backup-local-check.service"
ln -sf "$DIRECTORY/backup-local-check.timer" "$UNITS/backup-local-check.timer"
ln -sf "$DIRECTORY/backup-offsite@.service" "$UNITS/backup-offsite@.service"
ln -sf "$DIRECTORY/backup-offsite@documents.timer" "$UNITS/backup-offsite@documents.timer"
ln -sf "$DIRECTORY/backup-offsite@archive.timer" "$UNITS/backup-offsite@archive.timer"
ln -sf "$DIRECTORY/backup-offsite-check.service" "$UNITS/backup-offsite-check.service"
ln -sf "$DIRECTORY/backup-offsite-check.timer" "$UNITS/backup-offsite-check.timer"

systemctl --user daemon-reload
systemctl --user enable --now \
	backup-local@documents.timer \
	backup-local@archive.timer \
	backup-local@photos.timer \
	backup-local-check.timer \
	backup-offsite@documents.timer \
	backup-offsite@archive.timer \
	backup-offsite-check.timer
