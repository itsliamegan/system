#!/usr/bin/env bash

# install - install a restic release to ~/.local/opt and the packages the
#           backup services use.
#
# usage: backup/install

set -euo pipefail

RESTIC_VERSION="0.19.1"

DIRECTORY="$(dirname "$(realpath "$0")")"
RELEASE="restic_${RESTIC_VERSION}_linux_amd64"
DOWNLOAD="$HOME/.local/src/$RELEASE.bz2"
PREFIX="$HOME/.local/opt/restic-$RESTIC_VERSION"

sudo apt install -y $(xargs <"$DIRECTORY/packages")

mkdir -p "$HOME/.local/src" "$HOME/.local/bin"

curl -fsSL -o "$DOWNLOAD" "https://github.com/restic/restic/releases/download/v$RESTIC_VERSION/$RELEASE.bz2"
curl -fsSL -o "$HOME/.local/src/$RELEASE.SHA256SUMS" "https://github.com/restic/restic/releases/download/v$RESTIC_VERSION/SHA256SUMS"

cd "$HOME/.local/src"
grep " $RELEASE.bz2\$" "$RELEASE.SHA256SUMS" | sha256sum -c -

rm -rf "$PREFIX"
mkdir -p "$PREFIX/bin"
bunzip2 -c "$DOWNLOAD" >"$PREFIX/bin/restic"
chmod +x "$PREFIX/bin/restic"

ln -sfn "$PREFIX" "$HOME/.local/opt/restic"
ln -sf "$HOME/.local/opt/restic/bin/restic" "$HOME/.local/bin/restic"
