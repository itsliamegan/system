[Unit]
Description=Back up %i to the local repository
OnFailure=backup-failed@%n.service

[Service]
Type=oneshot
Environment=RESTIC_REPOSITORY=/mnt/data/restic
Environment=RESTIC_PASSWORD_FILE=%h/.config/backup/password
EnvironmentFile=%h/.config/backup/%i.env
ExecStart=%h/.local/bin/restic backup \
	--retry-lock 1h \
	--tag %i \
	--group-by host,tags \
	--skip-if-unchanged \
	%h/${BACKUP_PATH}
ExecStart=%h/.local/bin/restic forget \
	--retry-lock 1h \
	--tag %i \
	--group-by host,tags \
	--prune \
	$KEEP
