#!/usr/bin/env bash

# setup - setup system packages and configuration files.
#
# usage: setup <install|configure>
#
# install - install system packages and tools
# configure - symlink and write configuration files

set -euo pipefail

XDG_CONFIG_HOME="$HOME/.config"
XDG_DATA_HOME="$HOME/.local/share"

usage() {
	echo "setup - setup system packages and configuration files."
	echo "usage: setup <install|configure>"
	echo ""
	echo "install - install system packages and tools"
	echo "configure - symlink and write configuration files"
}

configure() {
	mkdir -p "$HOME/.claude"
	mkdir -p "$HOME/.local"
	mkdir -p "$HOME/.local/bin"
	mkdir -p "$XDG_CONFIG_HOME/agents"
	mkdir -p "$XDG_CONFIG_HOME/emacs"
	mkdir -p "$XDG_CONFIG_HOME/environment.d"
	mkdir -p "$XDG_CONFIG_HOME/fontconfig"
	mkdir -p "$XDG_CONFIG_HOME/mise"
	mkdir -p "$XDG_CONFIG_HOME/rustfmt"
	mkdir -p "$XDG_CONFIG_HOME/tmux"
	mkdir -p "$XDG_CONFIG_HOME/yt-dlp"
	mkdir -p "$XDG_DATA_HOME/konsole"

	ln -s "$PWD/agents/AGENTS.md" "$XDG_CONFIG_HOME/agents/AGENTS.md"
	ln -s "$PWD/agents/claude/CLAUDE.md" "$HOME/.claude/CLAUDE.md"
	ln -s "$PWD/agents/claude/settings.json" "$HOME/.claude/settings.json"
	ln -s "$PWD/agents/conventions" "$XDG_CONFIG_HOME/agents/conventions"
	ln -s "$PWD/agents/pi" "$XDG_CONFIG_HOME/pi"

	ln -s "$PWD/bin/dl-music" "$HOME/.local/bin/dl-music"

	ln -s "$PWD/emacs/init.el" "$XDG_CONFIG_HOME/emacs/init.el"
	ln -s "$PWD/emacs/themes" "$XDG_CONFIG_HOME/emacs/themes"

	for profile in $(sed -n 's/^Path=//p' "$HOME/.mozilla/firefox/profiles.ini"); do
		mkdir -p "$HOME/.mozilla/firefox/$profile/chrome"
		ln -s "$PWD/firefox/userChrome.css" "$HOME/.mozilla/firefox/$profile/chrome/userChrome.css"
		ln -s "$PWD/firefox/userContent.css" "$HOME/.mozilla/firefox/$profile/chrome/userContent.css"
	done

	ln -s "$PWD/fonts/archives" "$XDG_DATA_HOME/fonts"
	ln -s "$PWD/fonts/fonts.conf" "$XDG_CONFIG_HOME/fontconfig/fonts.conf"

	ln -s "$PWD/git" "$XDG_CONFIG_HOME/git"

	ln -s "$PWD/kde/konsole/Chalk.colorscheme" "$XDG_DATA_HOME/konsole/Chalk.colorscheme"
	ln -s "$PWD/kde/konsole/Profile.profile" "$XDG_DATA_HOME/konsole/Profile.profile"
	cp "$PWD/kde/plasma-org.kde.plasma.desktop-appletsrc" "$XDG_CONFIG_HOME/plasma-org.kde.plasma.desktop-appletsrc"
	"$PWD/kde/configure"

	ln -s "$PWD/langs/mise/config.toml" "$XDG_CONFIG_HOME/mise/config.toml"
	ln -s "$PWD/langs/rust/rustfmt.toml" "$XDG_CONFIG_HOME/rustfmt/rustfmt.toml"

	ln -s "$PWD/shell/.bashrc" "$HOME/.bashrc"
	ln -s "$PWD/shell/.inputrc" "$HOME/.inputrc"
	ln -s "$PWD/shell/.profile" "$HOME/.profile"
	ln -s "$PWD/shell/.xsessionrc" "$HOME/.xsessionrc"
	ln -s "$PWD/shell/environment.conf" "$XDG_CONFIG_HOME/environment.d/environment.conf"
	ln -s "$PWD/shell/tmux.conf" "$XDG_CONFIG_HOME/tmux/tmux.conf"
	ln -s "$PWD/shell/yt-dlp.conf" "$XDG_CONFIG_HOME/yt-dlp/config"

	sudo cp "$PWD/shell/disable-admin-flag" /etc/sudoers.d/disable-admin-flag
	sudo chown root:root /etc/sudoers.d/disable-admin-flag
	sudo chmod 0440 /etc/sudoers.d/disable-admin-flag
}

install() {
	sudo apt install -y $(xargs <packages)
	for tool in $(cat tools); do
		tool=$(printf "%s" "$tool" | tr -d "\n")
		curl -fsS "$tool" | sh
	done
	"$PWD/langs/rust/install"
	"$PWD/langs/python/install"
	"$PWD/langs/node/install"
	"$PWD/langs/typst/install"
	"$PWD/shell/install"
	"$PWD/emacs/install"
}

case "${1:-}" in
	install) install;;
	configure) configure;;
	*) usage;;
esac
