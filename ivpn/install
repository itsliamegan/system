#!/usr/bin/env bash

# install - install IVPN from IVPN's apt repository.
#
# usage: ivpn/install

set -euo pipefail

sudo install -d -m 0755 /etc/apt/keyrings
sudo curl -fsSL https://repo.ivpn.net/stable/debian/generic.gpg -o /etc/apt/keyrings/ivpn.asc
sudo install -m 0644 "$(dirname "$0")/ivpn.sources" /etc/apt/sources.list.d/ivpn.sources

sudo apt update
sudo apt install -y ivpn-ui
