#!/usr/bin/env bash

# install - install IVPN from IVPN's apt repository.
#
# usage: ivpn/install

set -euo pipefail

DIRECTORY="$(dirname "$(realpath "$0")")"

sudo install -d -m 0755 /etc/apt/keyrings
sudo curl -fsSL -o /etc/apt/keyrings/ivpn.asc https://repo.ivpn.net/stable/debian/generic.gpg
sudo install -m 0644 "$DIRECTORY/ivpn.sources" /etc/apt/sources.list.d/ivpn.sources

sudo apt update
sudo apt install -y ivpn-ui
