#!/usr/bin/env bash

# install - install Firefox from Mozilla's apt repository.
#
# usage: firefox/install

set -euo pipefail

sudo install -d -m 0755 /etc/apt/keyrings
sudo curl -fsSL https://packages.mozilla.org/apt/repo-signing-key.gpg -o /etc/apt/keyrings/mozilla.asc
sudo install -m 0644 "$(dirname "$0")/mozilla.sources" /etc/apt/sources.list.d/mozilla.sources

# Debian also ships firefox, and its versions sort above Mozilla's builds of the
# same release.
sudo install -m 0644 "$(dirname "$0")/firefox.pref" /etc/apt/preferences.d/firefox.pref

sudo apt update
sudo apt install -y firefox
