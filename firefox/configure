#!/usr/bin/env bash

# configure - link Firefox's user styles into every profile.
#
# usage: firefox/configure

set -euo pipefail

DIRECTORY="$(dirname "$(realpath "$0")")"

for profile in $(sed -n 's/^Path=//p' "$HOME/.mozilla/firefox/profiles.ini"); do
	mkdir -p "$HOME/.mozilla/firefox/$profile/chrome"
	ln -sf "$DIRECTORY/userChrome.css" "$HOME/.mozilla/firefox/$profile/chrome/userChrome.css"
	ln -sf "$DIRECTORY/userContent.css" "$HOME/.mozilla/firefox/$profile/chrome/userContent.css"
done
