#!/usr/bin/env bash

# install - install command-line tools with Cargo and uv.
#
# usage: shell/install

set -euo pipefail

FD_VERSION="10.5" # crates:fd-find
JUST_VERSION="1.59" # crates:just
RIPGREP_VERSION="15.2" # crates:ripgrep
SD_VERSION="1.0" # crates:sd

cargo install --locked \
	"fd-find@~$FD_VERSION" \
	"just@~$JUST_VERSION" \
	"ripgrep@~$RIPGREP_VERSION" \
	"sd@~$SD_VERSION"

# YouTube's changes break old versions, so yt-dlp always installs the latest.
uv tool install --upgrade 'yt-dlp[default]'
